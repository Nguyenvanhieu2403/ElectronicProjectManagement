\pard\sa200\sl276\slmult1\f0\fs22\lang9 H\f1\lang1066\u7885?\f0\lang9  V\'e0 T\'ean      : \f2\'d0\f0 inh Ti\f1\lang1066\u7871?\f0\lang9 n Anh \par
L\f1\lang1066\u7899?\f0\lang1033 p                  : DCCNTT13.10.4\par
M\'e3 Sinh Vi\'ean : 20220583    L\f1\lang1066\u7867?\f0\lang1033  : V\f1\lang1066\u7869?\f0\lang1033  Ng\'f4i Nh\'e0\par
\cf1\highlight2\f3\fs19 #include\cf3  \cf4 "glut.h"\cf3\par
\cf1 #include\cf3  \cf5 <math.h>\cf3\par
\par
\cf4 void\cf3  drawSquare(\cf4 float\cf3  \cf1 cx\cf3 , \cf4 float\cf3  \cf1 cy\cf3 , \cf4 float\cf3  \cf1 side_length\cf3 ) \{\par
    glBegin(\cf6 GL_POLYGON\cf3 );\par
    glVertex2f(\cf1 cx\cf3  - \cf1 side_length\cf3  / 2, \cf1 cy\cf3  - \cf1 side_length\cf3  / 2);\par
    glVertex2f(\cf1 cx\cf3  + \cf1 side_length\cf3  / 2, \cf1 cy\cf3  - \cf1 side_length\cf3  / 2);\par
    glVertex2f(\cf1 cx\cf3  + \cf1 side_length\cf3  / 2, \cf1 cy\cf3  + \cf1 side_length\cf3  / 2);\par
    glVertex2f(\cf1 cx\cf3  - \cf1 side_length\cf3  / 2, \cf1 cy\cf3  + \cf1 side_length\cf3  / 2);\par
    glEnd();\par
\}\par
\par
\cf4 void\cf3  drawTree(\cf4 float\cf3  \cf1 trunkHeight\cf3 , \cf4 float\cf3  \cf1 trunkWidth\cf3 , \cf4 float\cf3  \cf1 crownRadius\cf3 ) \{\par
    \cf7 // V\f4\lang1066\u7869? th\f5\lang1033\'e2n c\'e2y\cf3\par
    glColor3f(0.5f, 0.25f, 0.0f); \cf7 // M\'e0u th\'e2n c\'e2y n\'e2u\cf3\par
    glBegin(\cf6 GL_POLYGON\cf3 );\par
    glVertex2f(-\cf1 trunkWidth\cf3  / 2, -0.2f);  \cf7 // G\f4\lang1066\u7889?c tr\f5\lang1033\'e1i d\f6\u432?\f4\lang1066\u7899?i\cf3\par
    glVertex2f(\cf1 trunkWidth\cf3  / 2, -0.2f);   \cf7 // G\u7889?c ph\u7843?i d\f6\u432?\f4\u7899?i\cf3\par
    glVertex2f(\cf1 trunkWidth\cf3  / 2, -0.2f + \cf1 trunkHeight\cf3 ); \cf7 // G\u7889?c ph\u7843?i tr\f5\lang1033\'ean\cf3\par
    glVertex2f(-\cf1 trunkWidth\cf3  / 2, -0.2f + \cf1 trunkHeight\cf3 ); \cf7 // G\f4\lang1066\u7889?c tr\f5\lang1033\'e1i tr\'ean\cf3\par
    glEnd();\par
\par
    \cf7 // V\f4\lang1066\u7869? ng\u7885?n c\f5\lang1033\'e2y\cf3\par
    glColor3f(0.0f, 1.0f, 0.0f); \cf7 // M\'e0u xanh cho ng\f4\lang1066\u7885?n c\f5\lang1033\'e2y\cf3\par
    glBegin(\cf6 GL_TRIANGLE_FAN\cf3 );\par
    glVertex2f(0.0f, -0.2f + \cf1 trunkHeight\cf3 ); \cf7 // \f6\'d0\f4\lang1066\u7881?nh ng\u7885?n c\f5\lang1033\'e2y\cf3\par
    \cf4 for\cf3  (\cf4 int\cf3  i = 0; i <= 360; i++) \{\par
        \cf4 float\cf3  angle = i * 3.14159f / 180.0f;\par
        \cf4 float\cf3  x = \cf1 crownRadius\cf3  * cos(angle);\par
        \cf4 float\cf3  y = \cf1 crownRadius\cf3  * sin(angle);\par
        glVertex2f(x, y - 0.2f + \cf1 trunkHeight\cf3 );\par
    \}\par
    glEnd();\par
\}\par
\par
\cf4 void\cf3  display() \{\par
    glClear(\cf6 GL_COLOR_BUFFER_BIT\cf3 );\par
    \cf7 // V\f4\lang1066\u7869? tr\u7909?c ngang khung h\f5\lang1033\'ecnh\cf3\par
    glColor3f(0.0f, 0.0f, 0.0f); \cf7 // M\'e0u \f6\'f0en (ho\f4\lang1066\u7863?c t\f5\lang1033\'f9y \'fd)\cf3\par
    glBegin(\cf6 GL_LINES\cf3 );\par
\par
    \cf7 // V\f4\lang1066\u7869? tr\u7909?c ngang\cf3\par
    glVertex2f(-1.0f, 0.0f);  \cf7 // B\u7855?t \f6\'f0\f4\u7847?u tr\u7909?c ngang (x=-1.0, y=0)\cf3\par
    glVertex2f(1.0f, 0.0f);   \cf7 // K\u7871?t th\f5\lang1033\'fac tr\f4\lang1066\u7909?c ngang (x=1.0, y=0)\cf3\par
\par
    \cf7 // V\u7869? tr\u7909?c d\u7885?c \cf3\par
    glVertex2f(0.0f, -1.0f);  \cf7 // B\u7855?t \f6\'f0\f4\u7847?u tr\u7909?c d\u7885?c (x=0, y=-1)\cf3\par
    glVertex2f(0.0f, 1.0f);   \cf7 // K\u7871?t th\f5\lang1033\'fac tr\f4\lang1066\u7909?c d\u7885?c (x=0, y=1)\cf3\par
\par
    glEnd();\par
\par
    \cf7 // V\u7869? th\f5\lang1033\'e2n nh\'e0\cf3\par
    glColor3f(0.8, 0.5, 0.2);\par
    glBegin(\cf6 GL_POLYGON\cf3 );\par
    glVertex2f(-0.3, -0.5);\par
    glVertex2f(0.3, -0.5);\par
    glVertex2f(0.3, 0.0);\par
    glVertex2f(-0.3, 0.0);\par
    glEnd();\par
    \cf7 // V\f4\lang1066\u7869? \u7889?ng kh\f5\lang1033\'f3i \cf3\par
    glPushMatrix();\par
    glTranslatef(0.25f, 0.37f, 0.0f); \cf7 // D\f4\lang1066\u7883?ch l\f5\lang1033\'ean b\'ean ph\f4\lang1066\u7843?i tr\f5\lang1033\'ean m\'e1i nh\'e0\cf3\par
    glScalef(0.5f, 0.5f, 1.0f);       \cf7 // Thu nh\f4\lang1066\u7887? c\u7917?a ch\f5\lang1033\'ednh th\'e0nh \f4\lang1066\u7889?ng kh\f5\lang1033\'f3i\cf3\par
    glColor3f(0.4, 0.2, 0.1);         \cf7 // C\'f9ng m\'e0u v\f4\lang1066\u7899?i c\u7917?a\cf3\par
    glBegin(\cf6 GL_POLYGON\cf3 );\par
    glVertex2f(-0.075, -0.5);   \cf7 // G\u7889?c d\f6\u432?\f4\u7899?i tr\f5\lang1033\'e1i \cf3\par
    glVertex2f(0.075, -0.5);    \cf7 // G\f4\lang1066\u7889?c d\f6\u432?\f4\u7899?i ph\u7843?i\cf3\par
    glVertex2f(0.075, -0.1);    \cf7 // G\u7889?c tr\f5\lang1033\'ean ph\f4\lang1066\u7843?i\cf3\par
    glVertex2f(-0.075, -0.1);   \cf7 // G\u7889?c tr\f5\lang1033\'ean tr\'e1i\cf3\par
    glEnd();\par
    glPopMatrix();\par
\par
    \cf7 // V\f4\lang1066\u7869? m\f5\lang1033\'e1i nh\'e0 h\'ecnh tam gi\'e1c\cf3\par
    glColor3f(1.0, 0.0, 0.0); \cf7 // \f6\'d0\f4\lang1066\u7887? t\f6\u432?\u417?i\cf3\par
    glBegin(\cf6 GL_TRIANGLES\cf3 );\par
    glVertex2f(-0.4, 0.0);   \cf7 // G\f4\u7889?c tr\f5\lang1033\'e1i\cf3\par
    glVertex2f(0.4, 0.0);    \cf7 // G\f4\lang1066\u7889?c ph\u7843?i\cf3\par
    glVertex2f(0.0, 0.4);    \cf7 // \f6\'d0\f4\u7881?nh tam gi\f5\lang1033\'e1c\cf3\par
    glEnd();\par
\par
    \cf7 // V\f4\lang1066\u7869? c\u7917?a s\u7893? vu\f5\lang1033\'f4ng\cf3\par
    glColor3f(0.0f, 0.5f, 1.0f);\par
    drawSquare(-0.2f, -0.2f, 0.1f); \cf7 // C\f4\lang1066\u7917?a s\u7893? vu\f5\lang1033\'f4ng c\'f3 chi\f4\lang1066\u7873?u d\f5\lang1033\'e0i c\f4\lang1066\u7841?nh l\f5\lang1033\'e0 0.1\cf3\par
\par
    \cf7 // V\f4\lang1066\u7869? c\u7917?a ch\f5\lang1033\'ednh \cf3\par
    glColor3f(0.4, 0.2, 0.1); \cf7 // N\'e2u \f6\'f0\f4\lang1066\u7853?m\cf3\par
    glBegin(\cf6 GL_POLYGON\cf3 );\par
    glVertex2f(-0.075, -0.5); \cf7 // G\u7889?c d\f6\u432?\f4\u7899?i tr\f5\lang1033\'e1i\cf3\par
    glVertex2f(0.075, -0.5); \cf7 // G\f4\lang1066\u7889?c d\f6\u432?\f4\u7899?i ph\u7843?i\cf3\par
    glVertex2f(0.075, -0.1); \cf7 // G\u7889?c tr\f5\lang1033\'ean ph\f4\lang1066\u7843?i\cf3\par
    glVertex2f(-0.075, -0.1); \cf7 // G\u7889?c tr\f5\lang1033\'ean tr\'e1i\cf3\par
    glEnd();\par
\par
    \cf7 // D\f4\lang1066\u7883?ch c\f5\lang1033\'e2y sang b\'ean tr\'e1i g\f4\lang1066\u7847?n ng\f5\lang1033\'f4i nh\'e0\cf3\par
    glPushMatrix();\par
    glTranslatef(-0.6f, 0.0f, 0.0f); \cf7 // D\f4\lang1066\u7883?ch chuy\u7875?n c\f5\lang1033\'e2y sang b\'ean tr\'e1i\cf3\par
    drawTree(0.4f, 0.1f, 0.2f); \cf7 // C\'e2y v\f4\lang1066\u7899?i chi\u7873?u cao th\f5\lang1033\'e2n 0.4, chi\f4\lang1066\u7873?u r\u7897?ng th\f5\lang1033\'e2n 0.1 v\'e0 b\'e1n k\'ednh ng\f4\lang1066\u7885?n 0.2\cf3\par
    glPopMatrix();\par
\par
    glFlush();\par
\}\par
\par
\cf4 void\cf3  init() \{\par
    glClearColor(1.0, 1.0, 1.0, 1.0); \cf7 // Thay n\u7873?n th\f5\lang1033\'e0nh m\'e0u tr\f4\lang1066\u7855?ng\cf3\par
    glMatrixMode(\cf6 GL_PROJECTION\cf3 );\par
    glLoadIdentity();\par
    gluOrtho2D(-1.0, 1.0, -1.0, 1.0);\par
\}\par
\par
\cf4 int\cf3  main(\cf4 int\cf3  \cf1 argc\cf3 , \cf4 char\cf3 ** \cf1 argv\cf3 ) \{\par
    glutInit(&\cf1 argc\cf3 , \cf1 argv\cf3 );\par
    glutInitWindowSize(800, 600);\par
    glutCreateWindow(\cf5 "Nha va Cay"\cf3 );\par
    init();\par
    glutDisplayFunc(display);\par
    glutMainLoop();\par
    \cf4 return\cf3  0;\par
\}\par

